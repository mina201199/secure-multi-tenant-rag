# 複製成 .env 後，把每個 change-me 換成自己產生的隨機值（.env 已在 .gitignore，不會被提交）
# 密碼會被組進 postgresql:// 連線字串，只使用英文字母與數字，避免 @ : / 等字元破壞網址
# 產生方式範例：python -c "import secrets; print(secrets.token_hex(24))"

# 開發資料庫 owner，只給 setup 初始化使用，web 拿不到
POSTGRES_OWNER_PASSWORD=change-me
# web 使用的受限資料庫角色 rag_app
RUNTIME_DB_PASSWORD=change-me
# 啟用 worker profile 時填入獨立隨機密碼；不可與 owner/web 共用。留空表示停用 worker 登入。
WORKER_DB_PASSWORD=
# CSRF 簽章密鑰，至少 32 字元
APP_CSRF_SECRET=change-me
# 兩家虛構公司所有 seed 測試帳號共用的登入密碼
SEED_USER_PASSWORD=change-me

# 測試資料庫使用另一組密碼，讓測試無法誤連開發資料庫
TEST_POSTGRES_OWNER_PASSWORD=change-me
TEST_RUNTIME_DB_PASSWORD=change-me
TEST_WORKER_DB_PASSWORD=
